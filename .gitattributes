# Files that are executed or parsed on the Linux VPS must keep LF endings.
# Without this, core.autocrlf on Windows checkouts rewrites them to CRLF and
# deploy/sync.sh copies the CRLF straight to the server, where bash fails with
# "\r: command not found" and nginx/compose reject the stray carriage returns.
*.sh            text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.*          text eol=lf
requirements.txt text eol=lf
