# Production environment for docker-compose.prod.yml.
# Copy to .env on the server and fill in. Never commit the filled-in copy.
#
# Generate strong values with:
#   openssl rand -hex 32

# --- Domain / TLS ---
# TLS is terminated by the host nginx + certbot, not by this stack.
DOMAIN=optionscreener.online
ACME_EMAIL=you@example.com
# Loopback port the frontend container publishes for nginx to proxy to
FRONTEND_PORT=8080

# --- Database ---
DB_USER=micromachines
DB_PASSWORD=CHANGE_ME
DB_NAME=micromachines

# --- Auth ---
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Search ---
MEILISEARCH_MASTER_KEY=CHANGE_ME

# --- GST / invoicing ---
SELLER_STATE=Maharashtra
SELLER_GSTIN=
DEFAULT_GST_RATE=18
FROM_EMAIL=noreply@optionscreener.online

# --- Optional integrations (features stay disabled while blank) ---
# AI product upload
OPENAI_API_KEY=
# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Image storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=micromachines-uploads
AWS_REGION=ap-south-1
# Transactional email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
